{
  "name": "jordleie-no",
  "version": "1.0.0",
  "description": "Platform for renting farmland in Norway",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "build": "prisma generate && prisma migrate deploy",
    "dev": "nodemon app.js",
    "postinstall": "prisma generate",
    "seed": "node seed.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@supabase/supabase-js": "^2.100.1",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "method-override": "^3.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^5.7.0"
  }
}
