<%- include('partials/head') %>
<%- include('partials/sidebar') %>

<main class="main-content">
  <div class="not-found-page">
    <div style="margin-bottom:12px; color:var(--text-mid);"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
    <h1 style="font-size:2.5rem;">500</h1>
    <h2 style="font-size:1.4rem; font-weight:700; margin-bottom:10px;">Noe gikk galt</h2>
    <p style="color:var(--text-mid); margin-bottom:8px; max-width:420px; line-height:1.6;">
      <%= message || "En uventet feil oppstod. Sjekk at databasen er koblet til og at tabellene er migrert." %>
    </p>
    <% if (hint) { %>
      <div style="background:var(--beige-light); border:1px solid var(--border); border-radius:var(--radius); padding:14px 18px; margin:18px 0; max-width:460px; text-align:left; font-size:0.85rem; color:var(--text-mid); line-height:1.6;">
        <strong style="color:var(--text-dark);">Tips:</strong> <%= hint %>
      </div>
    <% } %>
    <a href="/auksjoner" class="btn btn-primary" style="margin-top:8px;">← Prøv igjen</a>
    &nbsp;
    <a href="/" class="btn btn-outline" style="margin-top:8px;">Til forsiden</a>
  </div>
  <%- include('partials/footer') %>
</main>
