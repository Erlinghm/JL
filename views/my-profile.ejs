<%- include('partials/head') %>
<%- include('partials/sidebar') %>

<main class="main-content">
  <%
    const identityVerification = (user.verifications || []).find((verification) => verification.type === "IDENTITY");
    const isBankIdVerified = identityVerification?.status === "VERIFIED";
    const createListingHref = isBankIdVerified ? "/lag-annonse" : "/bankid/verifiser?next=%2Flag-annonse";
  %>

  <div class="page-header">
    <h1 style="display:flex;align-items:center;gap:8px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      Min bruker
    </h1>
    <a href="<%= createListingHref %>" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
      Legg ut jord
    </a>
  </div>

  <div class="form-page" style="max-width:960px;">
    <% if (success) { %>
      <div style="margin-bottom:18px; border:1px solid #c9dfc2; background:#eef8eb; color:#29552d; padding:14px 16px; border-radius:14px;"><%= success %></div>
    <% } %>

    <% if (error) { %>
      <div style="margin-bottom:18px; border:1px solid #f5c2b8; background:#fff1ef; color:#8a3328; padding:14px 16px; border-radius:14px;"><%= error %></div>
    <% } %>

    <div class="form-section" style="display:grid; grid-template-columns:auto 1fr auto; gap:24px; align-items:center;">
      <div style="width:80px; height:80px; border-radius:50%; background:var(--green-dark); display:flex; align-items:center; justify-content:center; color:white; font-size:2rem; font-weight:800;">
        <%= (user.fullName || user.email).split(" ").map((part) => part[0]).join("").slice(0,2).toUpperCase() %>
      </div>
      <div>
        <h2 style="font-size:1.3rem; font-weight:800; margin-bottom:4px;"><%= user.fullName %></h2>
        <p style="color:var(--text-light); font-size:0.875rem;"><%= user.email %></p>
        <p style="color:var(--text-mid); font-size:0.82rem; margin-top:4px;">
          Rolle: <%= user.role %> · Status: <%= user.status %>
        </p>
      </div>
      <form action="/logg-ut" method="POST">
        <button type="submit" class="btn btn-outline">Logg ut</button>
      </form>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:22px;">
      <div class="form-section" style="grid-column:1/-1;">
        <div class="form-section-title" style="display:flex;align-items:center;gap:8px;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg> Kontooversikt</div>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:14px;">
          <div style="padding:18px; border-radius:14px; background:var(--bg-card); border:1px solid var(--border);">
            <div style="font-size:0.78rem; color:var(--text-light); text-transform:uppercase; letter-spacing:0.06em;">Fylke</div>
            <div style="font-size:1rem; font-weight:700; margin-top:6px;"><%= user.profile?.county || "Ikke satt" %></div>
          </div>
          <div style="padding:18px; border-radius:14px; background:var(--bg-card); border:1px solid var(--border);">
            <div style="font-size:0.78rem; color:var(--text-light); text-transform:uppercase; letter-spacing:0.06em;">Telefon</div>
            <div style="font-size:1rem; font-weight:700; margin-top:6px;"><%= user.phone || "Ikke satt" %></div>
          </div>
          <div style="padding:18px; border-radius:14px; background:var(--bg-card); border:1px solid var(--border);">
            <div style="font-size:0.78rem; color:var(--text-light); text-transform:uppercase; letter-spacing:0.06em;">Opprettet</div>
            <div style="font-size:1rem; font-weight:700; margin-top:6px;"><%= new Date(user.createdAt).toLocaleDateString("no-NO") %></div>
          </div>
          <div style="padding:18px; border-radius:8px; background:var(--bg-card); border:1px solid var(--border);">
            <div style="font-size:0.78rem; color:var(--text-light); text-transform:uppercase; letter-spacing:0.06em;">BankID</div>
            <div style="font-size:1rem; font-weight:700; margin-top:6px;"><%= isBankIdVerified ? "Verifisert" : "Ikke verifisert" %></div>
          </div>
        </div>
      </div>

      <div class="form-section">
        <div class="form-section-title" style="display:flex;align-items:center;gap:8px;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg> Kontoinnstillinger</div>
        <form action="/min-bruker" method="POST" style="display:flex; flex-direction:column; gap:14px;">
          <div class="form-group">
            <label class="form-label">Navn</label>
            <input type="text" class="form-input" name="fullName" value="<%= user.fullName %>" required>
          </div>
          <div class="form-group">
            <label class="form-label">E-post</label>
            <input type="email" class="form-input" value="<%= user.email %>" readonly>
          </div>
          <div class="form-group">
            <label class="form-label">Fylke</label>
            <input type="text" class="form-input" name="county" value="<%= user.profile?.county || '' %>" placeholder="F.eks. Innlandet">
          </div>
          <div class="form-group">
            <label class="form-label">Kort bio</label>
            <textarea class="form-textarea" name="bio" rows="4" placeholder="Fortell kort om deg og hva du bruker plattformen til."><%= user.profile?.bio || '' %></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Lagre endringer</button>
        </form>
      </div>

      <div class="form-section">
        <div class="form-section-title" style="display:flex;align-items:center;gap:8px;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg> Neste steg</div>
        <div style="display:grid; gap:12px;">
          <% if (!isBankIdVerified) { %>
            <a href="/bankid/verifiser?next=%2Fmin-bruker" class="btn btn-primary" style="justify-content:center;">Verifiser med BankID</a>
          <% } %>
          <a href="<%= createListingHref %>" class="btn btn-primary" style="justify-content:center;">Opprett ny annonse</a>
          <a href="/auksjoner" class="btn btn-outline" style="justify-content:center;">Utforsk auksjoner</a>
        </div>
        <div style="margin-top:18px; font-size:0.88rem; color:var(--text-mid); line-height:1.6;">
          BankID-verifisering kreves før du kan opprette annonser eller legge inn bud.
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
</main>
