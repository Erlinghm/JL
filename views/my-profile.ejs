<%- include('partials/head') %>
<%- include('partials/sidebar') %>

<main class="main-content">

  <div class="page-header">
    <h1 style="display:flex;align-items:center;gap:8px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      Min bruker
    </h1>
    <a href="/lag-annonse" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
      Legg ut jord
    </a>
  </div>

  <div class="form-page" style="max-width:960px;">

    <!-- Profile overview card -->
    <div class="form-section" style="display:grid; grid-template-columns:auto 1fr; gap:24px; align-items:center;">
      <div style="width:80px; height:80px; border-radius:50%; background:var(--green-dark); display:flex; align-items:center; justify-content:center; color:white; font-size:2rem; font-weight:800;">
        B
      </div>
      <div>
        <h2 style="font-size:1.3rem; font-weight:800; margin-bottom:4px;">Bonde Bruker</h2>
        <p style="color:var(--text-light); font-size:0.875rem;">bonde@example.com</p>
        <p style="color:var(--text-mid); font-size:0.82rem; margin-top:4px; display:flex; align-items:center; gap:5px;">Registrert bonde · Bekreftet identitet <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></p>
      </div>
    </div>

    <!-- Two column layout -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:22px;">

      <!-- My listings -->
      <div class="form-section" style="grid-column:1/-1;">
        <div class="form-section-title" style="display:flex;align-items:center;gap:8px;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg> Mine annonser</div>
        <div style="text-align:center; padding:40px; color:var(--text-light);">
          <div style="margin-bottom:10px;"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></div>
          <p>Du har ingen aktive annonser ennå.</p>
          <a href="/lag-annonse" class="btn btn-primary" style="margin-top:14px;">Lag din første annonse</a>
        </div>
      </div>

      <!-- My bids -->
      <div class="form-section">
        <div class="form-section-title" style="display:flex;align-items:center;gap:8px;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg> Mine bud</div>
        <div style="text-align:center; padding:30px; color:var(--text-light);">
          <div style="margin-bottom:8px;"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div>
          <p style="font-size:0.875rem;">Du har ikke lagt inn bud ennå.</p>
          <a href="/auksjoner" class="btn btn-outline btn-sm" style="margin-top:12px;">Se auksjoner</a>
        </div>
      </div>

      <!-- Account settings -->
      <div class="form-section">
        <div class="form-section-title" style="display:flex;align-items:center;gap:8px;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg> Kontoinnstillinger</div>
        <form style="display:flex; flex-direction:column; gap:14px;">
          <div class="form-group">
            <label class="form-label">Navn</label>
            <input type="text" class="form-input" value="Bonde Bruker">
          </div>
          <div class="form-group">
            <label class="form-label">E-post</label>
            <input type="email" class="form-input" value="bonde@example.com">
          </div>
          <div class="form-group">
            <label class="form-label">Fylke</label>
            <select class="form-select">
              <option>Velg fylke...</option>
              <option>Trøndelag</option>
              <option>Innlandet</option>
              <option>Rogaland</option>
              <option>Vestland</option>
              <option>Østfold</option>
            </select>
          </div>
          <button type="button" class="btn btn-primary" onclick="alert('Lagret! (Demo)')">Lagre endringer</button>
        </form>
      </div>

    </div>
  </div>

  <%- include('partials/footer') %>
</main>
