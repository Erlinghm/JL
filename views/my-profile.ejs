<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<%
  const displayName = user.fullName || user.email || "Bruker";
  const nameParts = displayName.split(/\s+/).filter(Boolean);
  const initials = (
    nameParts.length > 1
      ? nameParts.map((part) => part[0]).join("").slice(0, 2)
      : displayName.replace(/[^A-Za-z0-9ÆØÅæøå]/g, "").slice(0, 2)
  ).toUpperCase();
  const memberSince = new Intl.DateTimeFormat("no-NO", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(user.createdAt));
  const profile = user.profile || {};
  const isAdmin = Boolean(user.isAdmin);
%>

<main class="main-content">
  <div class="mb-shell">
    <% if (success || error) { %>
      <div class="mb-alert-stack">
        <% if (success) { %>
          <div class="mb-alert mb-alert--success" role="status"><%= success %></div>
        <% } %>
        <% if (error) { %>
          <div class="mb-alert mb-alert--error" role="alert"><%= error %></div>
        <% } %>
      </div>
    <% } %>

    <section class="mb-card mb-identity" aria-label="Brukeroversikt">
      <div class="mb-identity-main">
        <div class="mb-avatar" aria-hidden="true"><%= initials || "BR" %></div>
        <div class="mb-identity-copy">
          <h2 class="mb-identity-name"><%= displayName %></h2>
          <p class="mb-identity-email"><%= user.email %></p>
          <div class="mb-badges">
            <span class="mb-badge <%= isAdmin ? 'mb-badge--admin' : 'mb-badge--member' %>">
              <%= isAdmin ? "Administrator" : "Standardkonto" %>
            </span>
            <span class="mb-badge mb-badge--active">
              <span class="mb-badge-dot" aria-hidden="true"></span>
              Aktiv
            </span>
          </div>
          <p class="mb-meta">Medlem siden <%= memberSince %></p>
        </div>
      </div>
      <form action="/logg-ut" method="POST" class="mb-inline-form">
        <button type="submit" class="btn btn-outline mb-inline-button">Logg ut</button>
      </form>
    </section>

    <section class="mb-metrics" aria-label="Kontostatistikk">
      <article class="mb-card mb-metric">
        <div class="mb-metric-top">
          <span class="mb-eyebrow">Aktive annonser</span>
          <span class="mb-metric-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 10.5 12 3l9 7.5"></path>
              <path d="M5 9.5V20h14V9.5"></path>
              <path d="M9 20v-6h6v6"></path>
            </svg>
          </span>
        </div>
        <p class="mb-metric-value"><%= stats.activeListings %></p>
        <p class="mb-metric-help">Publiserte av deg</p>
      </article>

      <article class="mb-card mb-metric">
        <div class="mb-metric-top">
          <span class="mb-eyebrow">Aktive bud</span>
          <span class="mb-metric-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 5 19 10"></path>
              <path d="M11 8 16 13"></path>
              <path d="M7 12l5 5"></path>
              <path d="M4 20 14 10"></path>
              <path d="M16 3l5 5"></path>
              <path d="M2 22h8"></path>
            </svg>
          </span>
        </div>
        <p class="mb-metric-value"><%= stats.activeBids %></p>
        <p class="mb-metric-help">Åpne auksjoner du deltar i</p>
      </article>

      <article class="mb-card mb-metric">
        <div class="mb-metric-top">
          <span class="mb-eyebrow">Kontotype</span>
          <span class="mb-metric-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3 5 6v6c0 4.4 2.8 8.4 7 9.8 4.2-1.4 7-5.4 7-9.8V6l-7-3Z"></path>
              <path d="m9.5 12 1.7 1.7 3.3-3.7"></path>
            </svg>
          </span>
        </div>
        <p class="mb-metric-value mb-metric-value--type"><%= isAdmin ? "Administrator" : "Standard" %></p>
        <p class="mb-metric-help">Administrert via Supabase Auth</p>
      </article>
    </section>

    <div class="mb-body">
      <section class="mb-card">
        <div class="mb-card-header">
          <h2 class="mb-card-title">Profilinformasjon</h2>
        </div>

        <form action="/min-bruker" method="POST" class="mb-form">
          <fieldset class="mb-fieldset">
            <legend class="mb-fieldset-title">Identitet</legend>
            <div class="mb-field-grid">
              <div class="form-group mb-form-group">
                <label class="form-label mb-label" for="fullName">Navn</label>
                <input
                  id="fullName"
                  type="text"
                  name="fullName"
                  class="form-input mb-input"
                  value="<%= user.fullName %>"
                  required
                >
              </div>

              <div class="form-group mb-form-group">
                <label class="form-label mb-label" for="email">E-post</label>
                <input
                  id="email"
                  type="email"
                  class="form-input mb-input mb-input--readonly"
                  value="<%= user.email %>"
                  readonly
                  aria-readonly="true"
                >
                <p class="mb-field-help">E-post administreres via Supabase Auth</p>
              </div>
            </div>
          </fieldset>

          <div class="mb-separator" aria-hidden="true"></div>

          <fieldset class="mb-fieldset">
            <legend class="mb-fieldset-title">Drift</legend>
            <div class="mb-field-grid">
              <div class="form-group mb-form-group">
                <label class="form-label mb-label" for="county">Fylke</label>
                <input
                  id="county"
                  type="text"
                  name="county"
                  class="form-input mb-input"
                  value="<%= profile.county || '' %>"
                  placeholder="F.eks. Innlandet"
                >
              </div>

              <div class="form-group mb-form-group">
                <label class="form-label mb-label" for="bio">Kort bio</label>
                <textarea
                  id="bio"
                  name="bio"
                  class="form-textarea mb-input mb-textarea"
                  placeholder="Fortell kort om deg og hva du bruker plattformen til."
                ><%= profile.bio || '' %></textarea>
              </div>
            </div>
          </fieldset>

          <div class="mb-form-actions">
            <button type="submit" class="btn btn-primary--brand mb-submit">Lagre endringer</button>
          </div>
        </form>
      </section>

      <aside class="mb-sidebar">
        <section class="mb-card">
          <div class="mb-card-header">
            <h2 class="mb-card-title">Hurtighandlinger</h2>
          </div>

          <div class="mb-action-stack">
            <a href="/lag-annonse" class="btn btn-primary mb-action-button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14"></path>
                <path d="M5 12h14"></path>
              </svg>
              Opprett ny annonse
            </a>

            <a href="/auksjoner" class="btn btn-outline mb-action-button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m13 5 7 7-7 7"></path>
              </svg>
              Se auksjoner
            </a>
          </div>

          <p class="mb-card-copy mb-card-copy--offset">Administrer eiendom og budrunder fra ett sted.</p>
        </section>

        <section class="mb-card">
          <div class="mb-card-header">
            <div class="mb-card-title-row">
              <span class="mb-card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3 5 6v6c0 4.4 2.8 8.4 7 9.8 4.2-1.4 7-5.4 7-9.8V6l-7-3Z"></path>
                  <path d="m9.5 12 1.7 1.7 3.3-3.7"></path>
                </svg>
              </span>
              <h2 class="mb-card-title">Kontosikkerhet</h2>
            </div>
          </div>

          <p class="mb-card-copy">Innlogging og kontotilgang administreres via Supabase Auth. Bruk utlogging nedenfor for å avslutte økten på denne enheten.</p>

          <form action="/logg-ut" method="POST" class="mb-block-form">
            <button type="submit" class="btn btn-outline mb-action-button">Logg ut</button>
          </form>
        </section>
      </aside>
    </div>
  </div>

  <%- include('partials/footer') %>
</main>
