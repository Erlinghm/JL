<!-- Left sidebar – platform navigation -->
<aside class="app-sidebar">

  <!-- Logo -->
  <div class="app-sidebar-logo">
    <a href="/" class="app-sidebar-logo-link">
      <span class="app-sidebar-wordmark">Jordleie.no</span>
      <span class="app-sidebar-tagline">Markedsplass for jordleie</span>
    </a>
  </div>

  <!-- Nav links -->
  <nav class="app-sidebar-nav">
    <ul>

      <li>
        <a href="/auksjoner" class="app-sidebar-link">
          <span class="app-sidebar-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 9-2 2 8 8 2-2"/><path d="M13 5l4 4"/><path d="m5 21 4-2-2-4"/><line x1="4" y1="4" x2="20" y2="20"/></svg>
          </span>
          Auksjoner
        </a>
      </li>

      <li>
        <a href="/om-jordleie" class="app-sidebar-link">
          <span class="app-sidebar-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          </span>
          Om Jordleie.no
        </a>
      </li>

      <li>
        <a href="/hvordan-kjope-selge" class="app-sidebar-link">
          <span class="app-sidebar-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
          </span>
          Hvordan kjøpe &amp; selge
        </a>
      </li>

      <li>
        <a href="/artikler" class="app-sidebar-link">
          <span class="app-sidebar-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a4 4 0 0 1-4-4V6a2 2 0 0 1 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6z"/></svg>
          </span>
          Artikler
        </a>
      </li>

      <li>
        <a href="/kontakt" class="app-sidebar-link">
          <span class="app-sidebar-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </span>
          Kontakt oss
        </a>
      </li>

    </ul>

    <div class="app-sidebar-divider"></div>

    <ul>
      <li>
        <a href="/min-bruker" class="app-sidebar-link">
          <span class="app-sidebar-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
          Min bruker
        </a>
      </li>
      <% if (!currentUser) { %>
        <li>
          <a href="/logg-inn" class="app-sidebar-link">
            <span class="app-sidebar-icon">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            </span>
            Logg inn
          </a>
        </li>
      <% } %>
    </ul>
  </nav>

  <% if (currentUser) { %>
    <div class="app-sidebar-divider"></div>
    <div style="padding:0 22px 22px;">
      <div style="font-size:0.78rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-light); margin-bottom:8px;">Innlogget som</div>
      <div style="font-weight:700; color:var(--text);"><%= currentUser.fullName %></div>
      <div style="font-size:0.84rem; color:var(--text-mid); margin-top:2px;"><%= currentUser.email %></div>
      <form action="/logg-ut" method="POST" style="margin-top:14px;">
        <button type="submit" class="btn btn-outline btn-sm" style="width:100%; justify-content:center;">Logg ut</button>
      </form>
    </div>
  <% } %>

</aside>
