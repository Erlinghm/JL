<%- include('partials/head') %>
<%- include('partials/sidebar') %>

<main class="main-content">

  <div class="page-header">
    <h1 style="display:flex;align-items:center;gap:8px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      Jordleigeavtale #<%= lease.id %>
    </h1>
    <span style="padding:6px 12px; border-radius:999px; font-size:0.8rem; font-weight:700;
      background:<%= lease.status === 'SIGNED' ? '#eef8eb' : lease.status === 'DRAFT' ? '#fff6e5' : '#eef2ff' %>;
      color:<%= lease.status === 'SIGNED' ? '#29552d' : lease.status === 'DRAFT' ? '#8a5a10' : '#3a3f7e' %>;">
      <%= lease.status %>
    </span>
  </div>

  <div class="form-page" style="max-width:960px;">
    <% if (success) { %>
      <div style="margin-bottom:18px; border:1px solid #c9dfc2; background:#eef8eb; color:#29552d; padding:14px 16px; border-radius:14px;"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div style="margin-bottom:18px; border:1px solid #f5c2b8; background:#fff1ef; color:#8a3328; padding:14px 16px; border-radius:14px;"><%= error %></div>
    <% } %>

    <!-- Info-boks om auto-fylte vs manuelle felt -->
    <div style="margin-bottom:24px; padding:14px 18px; border-radius:14px; background:#eef2ff; border:1px solid #c7d4f3; color:#2d3a7a; font-size:0.9rem; line-height:1.5;">
      <strong>Om denne avtalen:</strong>
      Feltene i <span style="color:#1d5cd6; font-weight:700;">blått</span> er henta automatisk frå auksjonen og kan ikkje endrast her.
      Feltene nedanfor er resten som partane må fylle inn før signering.
    </div>

    <!-- === PART 1 & 2: Utleigar og leigetakar === -->
    <div class="form-section">
      <div class="form-section-title">1 · Utleigar (eigar)</div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; font-size:0.92rem;">
        <div><strong>Namn:</strong> <span style="color:#1d5cd6;"><%= lease.owner.fullName %></span></div>
        <div><strong>Fødselsdato:</strong> <span style="color:<%= lease.owner.birthDate ? '#1d5cd6' : '#a23e3e' %>;"><%= lease.owner.birthDate ? new Date(lease.owner.birthDate).toLocaleDateString("no-NO") : "(manglar)" %></span></div>
        <div><strong>Adresse:</strong> <span style="color:<%= lease.owner.addressFormatted ? '#1d5cd6' : '#a23e3e' %>;"><%= lease.owner.addressFormatted || "(må fyllast inn)" %></span></div>
        <div><strong>Telefon:</strong> <span style="color:<%= lease.owner.phone ? '#1d5cd6' : '#a23e3e' %>;"><%= lease.owner.phone || "(må fyllast inn)" %></span></div>
        <div><strong>E-post:</strong> <span style="color:#1d5cd6;"><%= lease.owner.email %></span></div>
      </div>
    </div>

    <div class="form-section">
      <div class="form-section-title">2 · Leigetakar</div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; font-size:0.92rem;">
        <div><strong>Namn:</strong> <span style="color:#1d5cd6;"><%= lease.tenant.fullName %></span></div>
        <div><strong>Fødselsdato / org.nr:</strong> <span style="color:<%= (lease.tenant.birthDate || lease.tenant.organizationNumber) ? '#1d5cd6' : '#a23e3e' %>;"><%= lease.tenant.birthDate ? new Date(lease.tenant.birthDate).toLocaleDateString("no-NO") : (lease.tenant.organizationNumber || "(manglar)") %></span></div>
        <div><strong>Adresse:</strong> <span style="color:<%= lease.tenant.addressFormatted ? '#1d5cd6' : '#a23e3e' %>;"><%= lease.tenant.addressFormatted || "(må fyllast inn)" %></span></div>
        <div><strong>Telefon:</strong> <span style="color:<%= lease.tenant.phone ? '#1d5cd6' : '#a23e3e' %>;"><%= lease.tenant.phone || "(må fyllast inn)" %></span></div>
        <div><strong>E-post:</strong> <span style="color:#1d5cd6;"><%= lease.tenant.email %></span></div>
      </div>
    </div>

    <!-- === PART 3: Omfang og leigeavgift === -->
    <div class="form-section">
      <div class="form-section-title">3 · Omfang og leigeavgift</div>
      <p style="color:var(--text-mid); font-size:0.9rem; margin-bottom:12px;">
        Eigar leiger ut jordbruksarealet på desse eigedomane til leigetakar:
      </p>
      <% if (lease.contract.matrikler && lease.contract.matrikler.length) { %>
        <table style="width:100%; border-collapse:collapse; font-size:0.92rem; color:#1d5cd6; margin-bottom:14px;">
          <thead>
            <tr style="text-align:left; border-bottom:1px solid var(--border);">
              <th style="padding:6px 10px 6px 0;">Gnr</th>
              <th style="padding:6px 10px;">Bnr</th>
              <th style="padding:6px 10px;">Kommune</th>
              <th style="padding:6px 10px;">Merknad</th>
            </tr>
          </thead>
          <tbody>
            <% lease.contract.matrikler.forEach(m => { %>
              <tr style="border-bottom:1px solid var(--border-subtle, #eee);">
                <td style="padding:8px 10px 8px 0;"><%= m.gnr || "–" %></td>
                <td style="padding:8px 10px;"><%= m.bnr || "–" %></td>
                <td style="padding:8px 10px;"><%= m.kommune || "–" %></td>
                <td style="padding:8px 10px;"><%= m.matrikkelNote || "" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div style="padding:12px; background:#fff6e5; border:1px solid #f5dfa0; border-radius:10px; color:#8a5a10; margin-bottom:14px;">Ingen matrikkel oppgitt i annonsen.</div>
      <% } %>

      <div style="margin-top:12px; font-size:0.92rem;">
        <table style="width:100%; border-collapse:collapse;">
          <thead>
            <tr style="text-align:left; border-bottom:1px solid var(--border); color:var(--text-light); text-transform:uppercase; font-size:0.78rem; letter-spacing:0.05em;">
              <th style="padding:6px 10px 6px 0;">Arealtype</th>
              <th style="padding:6px 10px; text-align:right;">Dekar</th>
              <th style="padding:6px 10px; text-align:right;">Kr / daa / år</th>
            </tr>
          </thead>
          <tbody style="color:#1d5cd6;">
            <tr><td style="padding:6px 10px 6px 0;">Fulldyrka jord</td><td style="padding:6px 10px; text-align:right;"><%= (lease.contract.areas.fulldyrka || 0).toLocaleString("no-NO") %></td><td style="padding:6px 10px; text-align:right;"><%= (lease.contract.amountPerDekarYear || 0).toLocaleString("no-NO") %></td></tr>
            <tr><td style="padding:6px 10px 6px 0;">Overflatedyrka jord</td><td style="padding:6px 10px; text-align:right;"><%= (lease.contract.areas.overflatedyrka || 0).toLocaleString("no-NO") %></td><td style="padding:6px 10px; text-align:right;"><%= (lease.contract.amountPerDekarYear || 0).toLocaleString("no-NO") %></td></tr>
            <tr><td style="padding:6px 10px 6px 0;">Innmarksbeite</td><td style="padding:6px 10px; text-align:right;"><%= (lease.contract.areas.innmarksbeite || 0).toLocaleString("no-NO") %></td><td style="padding:6px 10px; text-align:right;"><%= (lease.contract.amountPerDekarYear || 0).toLocaleString("no-NO") %></td></tr>
            <tr><td style="padding:6px 10px 6px 0;">Anna areal</td><td style="padding:6px 10px; text-align:right;"><%= (lease.contract.areas.anna || 0).toLocaleString("no-NO") %></td><td style="padding:6px 10px; text-align:right;"><%= (lease.contract.amountPerDekarYear || 0).toLocaleString("no-NO") %></td></tr>
            <tr style="border-top:1px solid var(--border); font-weight:700;"><td style="padding:10px 10px 10px 0;">Sum</td><td style="padding:10px 10px; text-align:right;"><%= (lease.contract.areas.total || 0).toLocaleString("no-NO") %></td><td style="padding:10px 10px; text-align:right;"></td></tr>
          </tbody>
        </table>
      </div>
      <% if (lease.contract.additionalTerms) { %>
        <div style="margin-top:12px; padding:10px 14px; background:#eef4ff; border-left:3px solid #1d5cd6; font-size:0.9rem; color:#1d5cd6;">
          <strong>Tillegg / atterhald om areala:</strong> <%= lease.contract.additionalTerms %>
        </div>
      <% } %>
    </div>

    <!-- === PART 4: Leigeavgift === -->
    <div class="form-section">
      <div class="form-section-title">4 · Leigeavgift</div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; font-size:0.92rem;">
        <div><strong>Samla årleg leigeavgift:</strong> <span style="color:#1d5cd6; font-weight:700;">kr <%= (lease.contract.totalAnnualAmount || 0).toLocaleString("no-NO") %></span></div>
        <div><strong>MVA i tillegg:</strong> <span style="color:#1d5cd6;"><%= lease.contract.vatApplies ? "Ja" : "Nei" %></span></div>
        <div><strong>Forfallsdato kvart år:</strong> <span style="color:<%= lease.contract.paymentDueDate ? '#1d5cd6' : '#a23e3e' %>;"><%= lease.contract.paymentDueDate || "(må fyllast inn)" %></span></div>
        <div><strong>Første forfall:</strong> <span style="color:<%= lease.contract.firstDueDate ? '#1d5cd6' : '#a23e3e' %>;"><%= lease.contract.firstDueDate ? new Date(lease.contract.firstDueDate).toLocaleDateString("no-NO") : "(må fyllast inn)" %></span></div>
        <div><strong>Indeksregulering:</strong> <span style="color:#1d5cd6;"><%= lease.contract.indexRegulation ? "Ja" : "Nei" %></span></div>
        <% if (lease.contract.indexRegulation) { %>
          <div><strong>Indeks:</strong> <span style="color:#1d5cd6;"><%= lease.contract.indexType || "–" %></span></div>
          <div><strong>Første reguleringsår:</strong> <span style="color:#1d5cd6;"><%= lease.contract.indexStartYear || "–" %></span></div>
          <div><strong>Utgangspunktsår:</strong> <span style="color:#1d5cd6;"><%= lease.contract.indexBaseYear || "–" %></span></div>
        <% } %>
      </div>
    </div>

    <!-- === PART 5: Varigheit === -->
    <div class="form-section">
      <div class="form-section-title">5 · Varigheit</div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; font-size:0.92rem;">
        <div><strong>Avtalen gjeld i:</strong> <span style="color:#1d5cd6;"><%= lease.contract.rentalPeriodYears %> år</span></div>
        <div><strong>Første leigeår:</strong> <span style="color:#1d5cd6;"><%= lease.contract.firstLeaseYear || "–" %></span></div>
        <div><strong>Frå:</strong> <span style="color:#1d5cd6;"><%= lease.startDate ? new Date(lease.startDate).toLocaleDateString("no-NO") : "–" %></span></div>
        <div><strong>Til:</strong> <span style="color:#1d5cd6;"><%= lease.endDate ? new Date(lease.endDate).toLocaleDateString("no-NO") : "–" %></span></div>
      </div>
    </div>

    <!-- === PART 6: Tilstand === -->
    <div class="form-section">
      <div class="form-section-title">6 · Tilstand</div>
      <div style="display:grid; gap:8px; font-size:0.92rem; color:#1d5cd6;">
        <div><strong style="color:var(--text);">Floghavre:</strong>
          <% if (lease.contract.hasFloghavre === true) { %>Det finst floghavre på eigedomen
          <% } else if (lease.contract.hasFloghavre === false) { %>Det finst ikkje floghavre
          <% } else { %><span style="color:#a23e3e;">(ikkje oppgitt)</span>
          <% } %>
        </div>
        <div><strong style="color:var(--text);">Tilstandsrapport vedlagt:</strong> <%= lease.contract.hasConditionReport ? "Ja" : "Nei" %></div>
        <div><strong style="color:var(--text);">Jordprøver utlevert:</strong> <%= lease.contract.hasSoilSamples ? "Ja" : "Nei" %></div>
        <div><strong style="color:var(--text);">Gjødselplan utlevert:</strong> <%= lease.contract.hasFertilizerPlan ? "Ja" : "Nei" %></div>
        <% if (lease.contract.conditionNotes) { %>
          <div style="margin-top:6px; padding:10px 14px; background:#eef4ff; border-left:3px solid #1d5cd6;">
            <strong style="color:var(--text);">Tilstandsopplysningar:</strong><br><%= lease.contract.conditionNotes %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- === MANUELLE FELT === -->
    <form action="/avtaler/<%= lease.id %>" method="POST">
      <div class="form-section">
        <div class="form-section-title" style="color:#8a5a10;">Felt som må fyllast ut manuelt</div>
        <p style="color:var(--text-mid); font-size:0.9rem; margin-bottom:14px;">
          Desse felta er ikkje dekka av annonsen og må fyllast inn før signering.
        </p>

        <div class="form-group">
          <label class="form-label" for="specialLeaseTerms">Andre vilkår om leigetid (pkt. 5)</label>
          <textarea id="specialLeaseTerms" name="specialLeaseTerms" class="form-textarea" rows="2"
                    placeholder="T.d. oppseiingsfrist, forlenging…"><%= lease.contractDataJson.specialLeaseTerms || "" %></textarea>
        </div>

        <div class="form-group">
          <label class="form-label" for="otherTerms">Andre forhold (pkt. 14)</label>
          <textarea id="otherTerms" name="otherTerms" class="form-textarea" rows="4"
                    placeholder="Fritekst om særlege forhold ved denne avtalen…"><%= lease.contractDataJson.otherTerms || "" %></textarea>
        </div>

        <div class="form-group">
          <label class="form-label" for="signingPlace">Stad for signering (pkt. 15)</label>
          <input type="text" id="signingPlace" name="signingPlace" class="form-input"
                 placeholder="T.d. Råde"
                 value="<%= lease.contractDataJson.signingPlace || "" %>">
        </div>
      </div>

      <!-- === SIGNATUR === -->
      <div class="form-section">
        <div class="form-section-title">15 · Signaturar</div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; font-size:0.9rem;">
          <div style="padding:14px; border-radius:12px; border:1px dashed var(--border);">
            <div style="font-size:0.8rem; color:var(--text-light); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Utleigar</div>
            <div style="color:#1d5cd6; font-weight:700;"><%= lease.owner.fullName %></div>
            <div style="margin-top:6px; color:var(--text-mid);">
              <% if (lease.ownerSignedAt) { %>
                ✓ Signert <%= new Date(lease.ownerSignedAt).toLocaleString("no-NO") %>
              <% } else { %>
                Ikkje signert
              <% } %>
            </div>
          </div>
          <div style="padding:14px; border-radius:12px; border:1px dashed var(--border);">
            <div style="font-size:0.8rem; color:var(--text-light); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Leigetakar</div>
            <div style="color:#1d5cd6; font-weight:700;"><%= lease.tenant.fullName %></div>
            <div style="margin-top:6px; color:var(--text-mid);">
              <% if (lease.tenantSignedAt) { %>
                ✓ Signert <%= new Date(lease.tenantSignedAt).toLocaleString("no-NO") %>
              <% } else { %>
                Ikkje signert
              <% } %>
            </div>
          </div>
        </div>
        <p style="margin-top:12px; color:var(--text-light); font-size:0.82rem;">
          Signering med BankID er ikkje aktivert enno. Det blir steg 2 i utviklinga.
        </p>
      </div>

      <!-- === SUBMIT === -->
      <div style="display:flex; justify-content:flex-end; gap:12px; padding: 0 0 40px;">
        <a href="/avtaler" class="btn btn-outline">Tilbake</a>
        <button type="submit" class="btn btn-primary">Lagre endringar</button>
      </div>
    </form>
  </div>

  <%- include('partials/footer') %>
</main>
