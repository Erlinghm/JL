<%- include('partials/head') %>
<%- include('partials/sidebar') %>

<main class="main-content">

  <div class="page-header" style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
    <div>
      <h1 style="display:flex; align-items:center; gap:8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Mine avtaler
      </h1>
      <p style="color:var(--text-mid); margin-top:4px;">
        Oversikt over jordleigeavtaler der du er eigar eller leigetakar.
      </p>
    </div>
    <a href="/auksjoner" class="btn btn-outline" style="text-decoration:none;">Til auksjoner</a>
  </div>

  <div class="form-page" style="max-width:1100px;">
    <% if (!leases || leases.length === 0) { %>
      <div style="padding:28px; border:1px dashed var(--border); border-radius:14px; text-align:center; color:var(--text-mid);">
        <div style="font-size:1rem; font-weight:700; color:var(--text); margin-bottom:6px;">
          Du har ingen avtaler enno
        </div>
        <p style="margin:0 0 12px;">
          Når ein auksjon du vann vert avslutta, eller du avsluttar ein auksjon
          som eigar, vil avtalen dukke opp her.
        </p>
        <a href="/auksjoner" class="btn btn-primary" style="text-decoration:none;">Sjå aktive auksjoner</a>
      </div>
    <% } else { %>
      <div style="display:grid; gap:12px;">
        <% leases.forEach(lease => {
             const isOwner = currentUser && lease.owner && lease.owner.id === currentUser.id;
             const counterpart = isOwner ? lease.tenant : lease.owner;
             const role = isOwner ? "Utleigar" : "Leigetakar";
             const status = lease.status || "DRAFT";
             const statusBg =
               status === "SIGNED" ? "#eef8eb" :
               status === "DRAFT"  ? "#fff6e5" :
               status === "SENT"   ? "#eef2ff" :
               status === "CANCELLED" ? "#fdecea" :
               "#eef2ff";
             const statusFg =
               status === "SIGNED" ? "#29552d" :
               status === "DRAFT"  ? "#8a5a10" :
               status === "SENT"   ? "#3a3f7e" :
               status === "CANCELLED" ? "#8a3328" :
               "#3a3f7e";
        %>
          <a href="/avtaler/<%= lease.id %>"
             style="display:flex; flex-wrap:wrap; gap:16px; align-items:center; justify-content:space-between;
                    padding:18px 20px; border:1px solid var(--border); border-radius:14px;
                    text-decoration:none; color:inherit; background:#fff;">
            <div style="min-width:240px;">
              <div style="font-size:0.78rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-light); margin-bottom:4px;">
                Avtale #<%= lease.id %> · <%= role %>
              </div>
              <div style="font-weight:700; font-size:1.05rem;">
                <%= lease.contract && lease.contract.title ? lease.contract.title : "Jordleigeavtale" %>
              </div>
              <div style="color:var(--text-mid); font-size:0.9rem; margin-top:2px;">
                <% if (lease.contract && lease.contract.municipality) { %>
                  <%= lease.contract.municipality %><% if (lease.contract.county) { %>, <%= lease.contract.county %><% } %>
                <% } %>
                <% if (counterpart && counterpart.fullName) { %>
                  · <%= isOwner ? "Leigetakar" : "Utleigar" %>: <%= counterpart.fullName %>
                <% } %>
              </div>
            </div>

            <div style="display:flex; gap:20px; align-items:center; flex-wrap:wrap;">
              <div style="text-align:right;">
                <div style="font-size:0.78rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-light);">Periode</div>
                <div style="font-weight:600;">
                  <%= lease.startDate ? new Date(lease.startDate).toLocaleDateString("no-NO") : "–" %>
                  –
                  <%= lease.endDate ? new Date(lease.endDate).toLocaleDateString("no-NO") : "–" %>
                </div>
              </div>
              <div style="text-align:right;">
                <div style="font-size:0.78rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-light);">Årleg leige</div>
                <div style="font-weight:700;">
                  <% if (lease.annualAmount) { %>
                    kr <%= Math.round(lease.annualAmount).toLocaleString("no-NO") %>
                  <% } else { %>
                    –
                  <% } %>
                </div>
              </div>
              <span style="padding:6px 12px; border-radius:999px; font-size:0.78rem; font-weight:700;
                           background:<%= statusBg %>; color:<%= statusFg %>;">
                <%= status %>
              </span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>
</main>
