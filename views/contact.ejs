<%- include('partials/head') %>
<%- include('partials/sidebar') %>

<main class="main-content">

  <div class="page-header">
    <h1 style="display:flex;align-items:center;gap:8px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      Kontakt oss
    </h1>
  </div>

  <div class="static-page" style="max-width:900px;">
    <% if (sendt) { %>
      <div style="background:var(--green-pale); border:1.5px solid #c1ddb8; border-radius:var(--radius); padding:16px 20px; margin-bottom:24px; display:flex; gap:12px; align-items:center;">
        <span style="display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:var(--green-dark);flex-shrink:0;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
        <div>
          <div style="font-weight:700; color:var(--green-dark);">Melding sendt!</div>
          <div style="font-size:0.875rem; color:var(--text-mid); margin-top:2px;">Takk for din henvendelse. Vi svarer innen 1–2 virkedager.</div>
        </div>
      </div>
    <% } %>
    <h1>Vi er her for å hjelpe</h1>
    <p class="lead">Har du spørsmål om plattformen, trenger du hjelp med en annonse, eller ønsker du å gi oss tilbakemelding? Ta gjerne kontakt.</p>

    <div class="contact-grid">

      <!-- Contact form -->
      <div>
        <h3>Send oss en melding</h3>
        <form style="display:flex; flex-direction:column; gap:14px;" onsubmit="handleContact(event)">
          <div class="form-group">
            <label class="form-label" for="cname">Navn *</label>
            <input type="text" id="cname" class="form-input" placeholder="Ditt navn" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="cemail">E-post *</label>
            <input type="email" id="cemail" class="form-input" placeholder="din@epost.no" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="csubject">Emne</label>
            <select id="csubject" class="form-select">
              <option>Generelt spørsmål</option>
              <option>Hjelp med annonse</option>
              <option>Teknisk problem</option>
              <option>Partnerskap</option>
              <option>Presse</option>
              <option>Annet</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="cmessage">Melding *</label>
            <textarea id="cmessage" class="form-textarea" rows="5" placeholder="Skriv din melding her..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Send melding →</button>
        </form>
      </div>

      <!-- Contact info -->
      <div class="contact-info">
        <h3>Kontaktinformasjon</h3>

          <div class="contact-info-item">
            <span style="flex-shrink:0; color:var(--green);"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>
            <div>
              <div style="font-size:0.75rem; font-weight:700; color:var(--text-light); text-transform:uppercase; letter-spacing:0.4px;">E-post</div>
              <div style="font-size:0.9rem; color:var(--text-dark); margin-top:2px;">hei@jordleie.no</div>
            </div>
          </div>
          <div class="contact-info-item">
            <span style="flex-shrink:0; color:var(--green);"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.81A16 16 0 0 0 16 16.91l.62-.62a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
            <div>
              <div style="font-size:0.75rem; font-weight:700; color:var(--text-light); text-transform:uppercase; letter-spacing:0.4px;">Telefon</div>
              <div style="font-size:0.9rem; color:var(--text-dark); margin-top:2px;">+47 900 00 000</div>
            </div>
          </div>
          <div class="contact-info-item">
            <span style="flex-shrink:0; color:var(--green);"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span>
            <div>
              <div style="font-size:0.75rem; font-weight:700; color:var(--text-light); text-transform:uppercase; letter-spacing:0.4px;">Adresse</div>
              <div style="font-size:0.9rem; color:var(--text-dark); margin-top:2px;">Stortingsgata 28, 0161 Oslo</div>
            </div>
          </div>
          <div class="contact-info-item">
            <span style="flex-shrink:0; color:var(--green);"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
            <div>
              <div style="font-size:0.75rem; font-weight:700; color:var(--text-light); text-transform:uppercase; letter-spacing:0.4px;">Åpningstider</div>
              <div style="font-size:0.9rem; color:var(--text-dark); margin-top:2px;">Man–fre 09:00–16:00</div>
            </div>
          </div>

        <div style="margin-top:28px; background:var(--green-pale); border:1px solid #c1ddb8; border-radius:var(--radius-lg); padding:18px;">
          <div style="font-weight:700; color:var(--green-dark); margin-bottom:6px; display:flex; align-items:center; gap:6px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/></svg> Rask hjelp</div>
          <p style="font-size:0.85rem; color:var(--text-mid); line-height:1.55; margin-bottom:12px;">
            De fleste svar finner du i vår guide for kjøp og salg.
          </p>
          <a href="/hvordan-kjope-selge" class="btn btn-outline btn-sm">Les guiden</a>
        </div>
      </div>

    </div>
  </div>

  <%- include('partials/footer') %>
</main>

<script>
  function handleContact(e) {
    e.preventDefault();
    alert("Takk for din melding! Vi svarer innen 1–2 virkedager.");
    e.target.reset();
  }
</script>
