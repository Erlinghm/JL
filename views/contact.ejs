<%- include('partials/head') %>
<%- include('partials/sidebar') %>

<main class="main-content">
  <div class="contact-page">
    <% if (sendt) { %>
      <div class="contact-alert" role="status">
        <span aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        <div>
          <strong>Melding sendt</strong>
          <p>Takk for henvendelsen. Vi svarer innen 1-2 virkedager.</p>
        </div>
      </div>
    <% } %>

    <section class="contact-hero">
      <div>
        <p class="contact-eyebrow">Kontakt Jordleie.no</p>
        <h1>Vi hjelper deg videre med jordleie.</h1>
        <p>
          Send oss en melding hvis du trenger hjelp med en annonse, budrunde,
          profil eller ønsker å gi tilbakemelding på plattformen.
        </p>
      </div>
      <aside class="contact-response-card" aria-label="Svarinformasjon">
        <span class="contact-response-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>
        </span>
        <strong>Normalt svar innen 1-2 virkedager</strong>
        <p>For konkrete annonser, legg gjerne ved annonsetittel eller lenke.</p>
      </aside>
    </section>

    <div class="contact-layout">
      <section class="contact-card contact-form-card" aria-labelledby="contact-form-title">
        <div class="contact-card-heading">
          <p class="contact-eyebrow">Melding</p>
          <h2 id="contact-form-title">Send oss en henvendelse</h2>
        </div>

        <form action="/kontakt" method="POST" class="contact-form">
          <div class="form-group">
            <label class="form-label" for="cname">Navn *</label>
            <input type="text" id="cname" name="name" class="form-input" placeholder="Ditt navn" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="cemail">E-post *</label>
            <input type="email" id="cemail" name="email" class="form-input" placeholder="din@epost.no" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="csubject">Emne</label>
            <select id="csubject" name="subject" class="form-select">
              <option>Generelt spørsmål</option>
              <option>Hjelp med annonse</option>
              <option>Teknisk problem</option>
              <option>Partnerskap</option>
              <option>Presse</option>
              <option>Annet</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="cmessage">Melding *</label>
            <textarea id="cmessage" name="message" class="form-textarea" rows="6" placeholder="Skriv kort hva du trenger hjelp med..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary contact-submit">Send melding</button>
        </form>
      </section>

      <aside class="contact-side">
        <section class="contact-card">
          <div class="contact-card-heading">
            <p class="contact-eyebrow">Direkte kontakt</p>
            <h2>Kontaktinformasjon</h2>
          </div>

          <div class="contact-info-list">
            <% [
              { label:"E-post", value:"hei@jordleie.no", icon:"mail" },
              { label:"Telefon", value:"+47 900 00 000", icon:"phone" },
              { label:"Adresse", value:"Stortingsgata 28, 0161 Oslo", icon:"home" },
              { label:"Åpningstider", value:"Man-fre 09:00-16:00", icon:"clock" }
            ].forEach(item => { %>
              <div class="contact-info-row">
                <span class="contact-info-icon" aria-hidden="true">
                  <% if (item.icon === "mail") { %>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                  <% } else if (item.icon === "phone") { %>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.81A16 16 0 0 0 16 16.91l.62-.62a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  <% } else if (item.icon === "home") { %>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5V21a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg>
                  <% } else { %>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                  <% } %>
                </span>
                <div>
                  <span><%= item.label %></span>
                  <strong><%= item.value %></strong>
                </div>
              </div>
            <% }) %>
          </div>
        </section>

        <section class="contact-help-card">
          <p class="contact-eyebrow">Rask hjelp</p>
          <h2>Usikker på prosessen?</h2>
          <p>Guiden forklarer hvordan grunneiere og leietakere bruker plattformen.</p>
          <a href="/hvordan-kjope-selge" class="btn btn-outline">Les guiden</a>
        </section>
      </aside>
    </div>
  </div>

  <%- include('partials/footer') %>
</main>
