<%- include('partials/head') %>
<%- include('partials/sidebar') %>

<main class="main-content">
  <div class="guide-page">
    <section class="guide-hero">
      <div class="guide-hero-copy">
        <p class="guide-eyebrow">Slik fungerer Jordleie.no</p>
        <h1>En ryddig prosess fra areal til avtale.</h1>
        <p>
          Få oversikt over hvordan grunneiere legger ut jord, hvordan bønder
          vurderer arealene, og hvordan budrunden går fra interesse til avtale.
        </p>
      </div>
      <div class="guide-hero-panel" aria-label="Kort oppsummert">
        <div>
          <span class="guide-panel-label">Prosess</span>
          <strong>2 roller</strong>
          <p>Grunneier og leietaker følger hver sin enkle arbeidsflyt.</p>
        </div>
        <div>
          <span class="guide-panel-label">Bud</span>
          <strong>Åpent og sporbart</strong>
          <p>Pris, frister og vilkår samles i samme prosess.</p>
        </div>
      </div>
    </section>

    <section class="guide-section" aria-labelledby="guide-landowners">
      <div class="guide-section-heading">
        <p class="guide-eyebrow">For grunneiere</p>
        <h2 id="guide-landowners">Legg ut jord uten å miste kontrollen.</h2>
      </div>

      <div class="guide-steps">
        <% [
          { step:"01", title:"Registrer deg", text:"Opprett en gratis bruker. Vi kobler profilen til arealet ditt slik at annonsen får riktig eier og kontaktpunkt." },
          { step:"02", title:"Lag annonse", text:"Legg inn beliggenhet, areal, jordkvalitet, leieperiode og praktiske vilkår. Teigene kan tegnes direkte på kartet." },
          { step:"03", title:"Sett auksjonsvilkår", text:"Velg startbud, budfrist og eventuelle minimumskrav før annonsen publiseres." },
          { step:"04", title:"Følg budrunden", text:"Se bud og interessenter underveis. Plattformen gir en tydelig oversikt over status og høyeste bud." },
          { step:"05", title:"Inngå avtale", text:"Når prosessen er ferdig kan partene gå videre med dokumentasjon og leieavtale på et tydelig grunnlag." }
        ].forEach(item => { %>
          <article class="guide-step-card">
            <span class="guide-step-number"><%= item.step %></span>
            <div>
              <h3><%= item.title %></h3>
              <p><%= item.text %></p>
            </div>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="guide-section guide-section--split" aria-labelledby="guide-renters">
      <div class="guide-section-heading guide-section-heading--sticky">
        <p class="guide-eyebrow">For leietakere</p>
        <h2 id="guide-renters">Finn arealer som passer driften din.</h2>
        <p>
          Bruk filtrering, kart og strukturert informasjon til å vurdere om
          arealet passer før du legger inn bud.
        </p>
        <a href="/auksjoner" class="btn btn-primary">Se auksjoner</a>
      </div>

      <div class="guide-checklist">
        <% [
          { title:"Opprett profil", text:"Fyll inn driftsprofil og kontaktinformasjon slik at grunneier vet hvem som byr." },
          { title:"Bla gjennom arealer", text:"Filtrer på fylke, jordtype, størrelse og status for å finne relevante annonser." },
          { title:"Vurder vilkår", text:"Les leieperiode, praktisk tilgang, jordkvalitet og eventuelle krav før bud legges inn." },
          { title:"Legg inn bud", text:"Bud gis per dekar per år. Du kan følge med hvis det kommer høyere bud." },
          { title:"Avklar overtakelse", text:"Når budrunden er ferdig går partene videre med avtale, kontakt og praktiske detaljer." }
        ].forEach(item => { %>
          <article class="guide-check-item">
            <span aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            <div>
              <h3><%= item.title %></h3>
              <p><%= item.text %></p>
            </div>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="guide-faq" aria-labelledby="guide-faq-title">
      <div class="guide-section-heading">
        <p class="guide-eyebrow">Vanlige spørsmål</p>
        <h2 id="guide-faq-title">Svar på det folk oftest lurer på.</h2>
      </div>

      <div class="guide-faq-list">
        <% [
          { q:"Hva koster det å bruke Jordleie.no?", a:"Det er gratis å opprette profil og bla gjennom annonser. Grunneiere betaler en provisjon ved vellykket utleie." },
          { q:"Er leieavtalene juridisk bindende?", a:"Avtaler inngås mellom grunneier og leietaker. Plattformen gjør prosessen ryddig og dokumentert, men partene må fortsatt sikre at avtalen passer deres forhold." },
          { q:"Kan jeg sette en minimumspris?", a:"Ja. Grunneier kan bruke vilkår og startbud for å styre hva som er akseptabelt før prosessen publiseres." },
          { q:"Må jeg besøke arealet før jeg byr?", a:"Det anbefales ved større eller komplekse arealer. Kart og beskrivelser gir et godt førstegrunnlag, men lokal vurdering kan fortsatt være nyttig." }
        ].forEach(faq => { %>
          <details class="guide-faq-item">
            <summary><%= faq.q %></summary>
            <p><%= faq.a %></p>
          </details>
        <% }) %>
      </div>
    </section>
  </div>

  <%- include('partials/footer') %>
</main>
