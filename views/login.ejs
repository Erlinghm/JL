<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wdth,wght@0,75..100,400..700;1,75..100,400..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/landing.css">
  <style>
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background:
        radial-gradient(circle at top, rgba(123, 162, 81, 0.16), transparent 32%),
        linear-gradient(180deg, #f6f8ef 0%, #eef2e2 100%);
    }

    .auth-nav {
      background: rgba(255,255,255,0.88);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(45,90,39,0.08);
      padding: 18px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .auth-page {
      flex: 1;
      display: grid;
      grid-template-columns: minmax(320px, 470px) minmax(320px, 520px);
      gap: 36px;
      align-items: center;
      justify-content: center;
      padding: 40px 24px;
    }

    .auth-side {
      padding: 28px 8px;
    }

    .auth-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(45,90,39,0.08);
      color: var(--green-dark);
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      margin-bottom: 22px;
    }

    .auth-side h1 {
      font-size: clamp(2.2rem, 4vw, 3.5rem);
      line-height: 1;
      letter-spacing: -0.05em;
      margin-bottom: 16px;
      color: #20371d;
    }

    .auth-side p {
      color: #405642;
      font-size: 1rem;
      line-height: 1.65;
      max-width: 38rem;
    }

    .auth-points {
      display: grid;
      gap: 14px;
      margin-top: 28px;
    }

    .auth-point {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      padding: 14px 16px;
      border-radius: 18px;
      background: rgba(255,255,255,0.72);
      border: 1px solid rgba(45,90,39,0.08);
    }

    .auth-point strong {
      display: block;
      margin-bottom: 3px;
      color: #20371d;
    }

    .auth-point span {
      color: #5d6f5e;
      font-size: 0.92rem;
    }

    .auth-card {
      background: rgba(255,255,255,0.92);
      border: 1px solid rgba(45,90,39,0.08);
      border-radius: 28px;
      padding: 34px;
      box-shadow: 0 28px 80px rgba(27, 54, 25, 0.12);
    }

    .auth-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: #eef2e2;
      border-radius: 999px;
      padding: 4px;
      margin-bottom: 26px;
    }

    .auth-tab {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      text-decoration: none;
      color: #506450;
      font-weight: 700;
      font-size: 0.92rem;
      border-radius: 999px;
      min-height: 42px;
    }

    .auth-tab.active {
      background: #ffffff;
      color: #20371d;
      box-shadow: 0 10px 24px rgba(27, 54, 25, 0.08);
    }

    .auth-card h2 {
      margin-bottom: 8px;
      font-size: 1.6rem;
      letter-spacing: -0.03em;
      color: #20371d;
    }

    .auth-card p {
      color: #5d6f5e;
      margin-bottom: 24px;
      line-height: 1.6;
    }

    .auth-alert {
      border-radius: 16px;
      padding: 14px 16px;
      margin-bottom: 18px;
      font-size: 0.92rem;
      line-height: 1.5;
    }

    .auth-alert.error {
      background: #fff1ef;
      color: #8a3328;
      border: 1px solid #f5c2b8;
    }

    .auth-alert.success {
      background: #eef8eb;
      color: #29552d;
      border: 1px solid #c9dfc2;
    }

    .auth-form {
      display: grid;
      gap: 14px;
    }

    .auth-field {
      display: grid;
      gap: 6px;
    }

    .auth-field label {
      font-size: 0.8rem;
      font-weight: 700;
      color: #506450;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .auth-field input {
      width: 100%;
      min-height: 50px;
      border: 1px solid rgba(45,90,39,0.14);
      border-radius: 14px;
      padding: 0 14px;
      font: inherit;
      background: #fff;
      color: #20371d;
    }

    .auth-field input:focus {
      outline: none;
      border-color: #4f7a45;
      box-shadow: 0 0 0 4px rgba(79,122,69,0.12);
    }

    .auth-submit {
      width: 100%;
      justify-content: center;
      margin-top: 6px;
      min-height: 52px;
    }

    .auth-footnote {
      margin-top: 16px;
      color: #728271;
      font-size: 0.82rem;
      line-height: 1.5;
    }

    .auth-footnote a {
      color: #2d5a27;
      font-weight: 700;
      text-decoration: none;
    }

    @media (max-width: 920px) {
      .auth-page {
        grid-template-columns: 1fr;
      }

      .auth-side {
        padding: 0;
      }
    }
  </style>
</head>
<body>
  <nav class="auth-nav">
    <a href="/" style="font-size:1.2rem; font-weight:800; color:var(--green); letter-spacing:-0.03em; text-decoration:none;">Jordleie.no</a>
    <a href="/" style="font-size:0.9rem; color:var(--text-mid); text-decoration:none;">Til forsiden</a>
  </nav>

  <main class="auth-page">
    <section class="auth-side">
      <div class="auth-kicker">Supabase Auth</div>
      <h1><%= mode === "signup" ? "Opprett bruker og kom i gang." : "Logg inn og fortsett i plattformen." %></h1>
      <p>
        Jordleie.no bruker Supabase Auth for innlogging og vedlikeholder en lokal brukerprofil i databasen,
        slik at annonser, bud og profilsider fortsatt passer resten av Prisma-modellene.
      </p>

      <div class="auth-points">
        <div class="auth-point">
          <div>01</div>
          <div>
            <strong>Trygge økter</strong>
            <span>Innlogging lagres i HTTP-only cookies på serveren.</span>
          </div>
        </div>
        <div class="auth-point">
          <div>02</div>
          <div>
            <strong>Klar for auksjoner</strong>
            <span>Innloggede brukere kan legge ut jord og gi bud med egne profiler.</span>
          </div>
        </div>
        <div class="auth-point">
          <div>03</div>
          <div>
            <strong>Samme bruker overalt</strong>
            <span>Supabase-brukeren kobles til lokal `User`-rad for videre domene-data.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="auth-card">
      <div class="auth-tabs">
        <a href="/logg-inn<%= next ? `?next=${encodeURIComponent(next)}` : '' %>" class="auth-tab <%= mode === 'login' ? 'active' : '' %>">Logg inn</a>
        <a href="/registrer-deg<%= next ? `?next=${encodeURIComponent(next)}` : '' %>" class="auth-tab <%= mode === 'signup' ? 'active' : '' %>">Registrer deg</a>
      </div>

      <h2><%= mode === "signup" ? "Opprett konto" : "Velkommen tilbake" %></h2>
      <p>
        <%= mode === "signup"
          ? "Opprett en bruker for å publisere jord, følge budrunder og administrere profilen din."
          : "Bruk e-post og passord for å få tilgang til brukerprofil, bud og dine annonser." %>
      </p>

      <% if (!authConfigured) { %>
        <div class="auth-alert error">
          Auth er ikke konfigurert ennå. Sett `SUPABASE_URL` og `SUPABASE_PUBLISHABLE_KEY` i miljøet før innlogging tas i bruk.
        </div>
      <% } %>

      <% if (error) { %>
        <div class="auth-alert error"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="auth-alert success"><%= success %></div>
      <% } %>

      <form
        class="auth-form"
        action="<%= mode === 'signup' ? '/auth/registrer-deg' : '/auth/logg-inn' %>"
        method="POST"
      >
        <input type="hidden" name="next" value="<%= next || '/min-bruker' %>">

        <% if (mode === "signup") { %>
          <div class="auth-field">
            <label for="fullName">Fullt navn</label>
            <input id="fullName" name="fullName" type="text" placeholder="Ola Nordmann" required>
          </div>
          <div class="auth-field">
            <label for="birthDate">Fødselsdato</label>
            <input id="birthDate" name="birthDate" type="date" required>
            <div style="font-size:0.75rem; color:#728271; margin-top:-2px;">
              Brukast for å fylle ut jordleigeavtaler. Vert oppdatert automatisk om du BankID-verifiserer.
            </div>
          </div>
        <% } %>

        <div class="auth-field">
          <label for="email">E-post</label>
          <input id="email" name="email" type="email" placeholder="navn@epost.no" required>
        </div>

        <div class="auth-field">
          <label for="password">Passord</label>
          <input
            id="password"
            name="password"
            type="password"
            placeholder="<%= mode === 'signup' ? 'Minst 8 tegn' : 'Skriv inn passordet ditt' %>"
            minlength="8"
            required
          >
        </div>

        <% if (mode === "signup") { %>
          <div class="auth-field">
            <label for="confirmPassword">Bekreft passord</label>
            <input id="confirmPassword" name="confirmPassword" type="password" placeholder="Skriv passordet på nytt" minlength="8" required>
          </div>
        <% } %>

        <button type="submit" class="btn-primary auth-submit">
          <%= mode === "signup" ? "Opprett konto" : "Logg inn" %>
        </button>
      </form>

      <div class="auth-footnote">
        <%= mode === "signup" ? "Har du allerede konto?" : "Mangler du konto?" %>
        <a href="<%= mode === 'signup' ? `/logg-inn${next ? `?next=${encodeURIComponent(next)}` : ''}` : `/registrer-deg${next ? `?next=${encodeURIComponent(next)}` : ''}` %>">
          <%= mode === "signup" ? "Logg inn her" : "Registrer deg gratis" %>
        </a>
      </div>
    </section>
  </main>
</body>
</html>
