<%- include('partials/head') %>
<%- include('partials/sidebar') %>

<main class="main-content">

  <div class="page-header">
    <h1 style="display:flex;align-items:center;gap:8px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a4 4 0 0 1-4-4V6a2 2 0 0 1 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6z"/></svg>
      Artikler
    </h1>
  </div>

  <!-- Intro -->
  <div style="padding:24px 36px 0; max-width:620px;">
    <p style="color:var(--text-mid); font-size:0.95rem; line-height:1.7;">
      Her deler vi kunnskap om jordleie, agronomi, jus og markedstrender – skrevet av og for norske bønder.
    </p>
  </div>

  <div class="articles-grid">

    <% const articles = [
      {
        icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 0 1 10 10c0 5.52-4.48 10-10 10S2 17.52 2 12c0-1.5.33-2.93.91-4.21"/><path d="M12 6v6l3 3"/><path d="M8 2.5C9.27 2.17 10.6 2 12 2"/></svg>`,
        color: "#e8f5e3",
        tag: "Marked",
        title: "Jordleieprisene i Norge 2025: Stor variasjon mellom fylkene",
        excerpt: "En ny gjennomgang viser at prisen per dekar varierer fra under 200 kr i Finnmark til over 1 000 kr på Jæren. Hva driver forskjellene?",
        author: "Marte Berg",
        date: "14. mars 2026",
        readtime: "5 min"
      },
      {
        icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
        color: "#eef0fb",
        tag: "Jus",
        title: "Hva sier jordloven om leieperiode og oppsigelse?",
        excerpt: "Mange bønder er usikre på sine juridiske rettigheter i et leieforhold. Vi gir en enkel gjennomgang av de viktigste reglene.",
        author: "Advokat Lars Dahl",
        date: "9. mars 2026",
        readtime: "7 min"
      },
      {
        icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v11m0 0h10m-10 0a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2m2 0h2"/><circle cx="12" cy="18" r="3"/></svg>`,
        color: "#fdf5e8",
        tag: "Agronomi",
        title: "Jordprøvetaking: Slik vet du hva slags jord du leier",
        excerpt: "En enkel jordanalyse kan avsløre pH, næringsstoffnivå og jordstruktur. Her er hva du bør se etter før du inngår en leieavtale.",
        author: "Geir Haugen, NLR",
        date: "2. mars 2026",
        readtime: "6 min"
      },
      {
        icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
        color: "#e8f5e3",
        tag: "Økonomi",
        title: "Er det lønnsomt å leie jord fremfor å eie?",
        excerpt: "Vi regner på alternativkostnadene og viser at leie kan gi langt høyere kapitalavkastning for mange bønder – spesielt i oppstartsfasen.",
        author: "Silje Moe",
        date: "22. feb. 2026",
        readtime: "8 min"
      },
      {
        icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/></svg>`,
        color: "#eef0fb",
        tag: "Teknologi",
        title: "Satellittbilder og AI: Fremtidens arealvurdering",
        excerpt: "Nye verktøy gjør det mulig å analysere jordkvalitet, dreneringstilstand og historisk avling fra rommet. Vi ser på hva som er mulig i dag.",
        author: "Teknologiredaksjonen",
        date: "15. feb. 2026",
        readtime: "4 min"
      },
      {
        icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
        color: "#fdf5e8",
        tag: "Historier",
        title: "Fra naboavtale til digital auksjon: Gårdens reise",
        excerpt: "Tor Helge Andresen i Stange prøvde Jordleie.no beta og fikk 40% høyere leiepris enn han hadde fått gjennom det lokale nettverket.",
        author: "Jordleie.no",
        date: "5. feb. 2026",
        readtime: "3 min"
      }
    ]; %>

    <% articles.forEach(a => { %>
      <div class="article-card">
        <div class="article-card-img" style="background:<%= a.color %>; color:var(--green-dark);"><%- a.icon %></div>
        <div class="article-card-body">
          <span class="article-tag"><%= a.tag %></span>
          <div class="article-title"><%= a.title %></div>
          <p class="article-excerpt"><%= a.excerpt %></p>
          <div class="article-meta">
            <%= a.author %> · <%= a.date %> · <%= a.readtime %> lesetid
          </div>
        </div>
      </div>
    <% }) %>

  </div>

  <%- include('partials/footer') %>
</main>
