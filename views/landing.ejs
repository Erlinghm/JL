<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="Jordleie.no kobler grunneiere og bønder gjennom åpne, transparente auksjoner. Finn ledig jord i hele Norge – eller legg ut ditt areal i dag.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Jordleie.no – Fremtidens jordleie">
  <meta property="og:description" content="Norges nye markedsplass for jordleie. Trygt, transparent og enkelt.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/landing.css">
</head>
<body>

  <!-- ===== NAVBAR ===== -->
  <nav class="lp-nav">
    <div class="lp-nav-inner">
      <a href="/" class="lp-logo">Jordleie.no</a>
      <ul class="lp-nav-links">
        <li><a href="#slik-fungerer-det">Slik fungerer det</a></li>
        <li><a href="#fordeler">Fordeler</a></li>
        <li><a href="#auksjoner">Auksjoner</a></li>
        <li><a href="#om-oss">Om oss</a></li>
        <li><a href="#kontakt">Kontakt</a></li>
      </ul>
      <div class="lp-nav-actions">
        <a href="/min-bruker" class="btn-nav-ghost">Logg inn</a>
        <a href="/lag-annonse" class="btn-nav-primary">Registrer deg</a>
      </div>
    </div>
  </nav>

  <!-- ===== HERO ===== -->
  <section class="lp-hero">

    <div class="lp-hero-img-left" aria-hidden="true">
      <img src="/images/hero-farm-illustration2.png" alt="">
    </div>

    <div class="lp-hero-text">
      <div class="lp-hero-eyebrow">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A4.49 4.49 0 0 0 8 20C19 20 22 3 22 3c-1 2-8 2-8 2s2-6-7-4z"/>
        </svg>
        Norges nye jordleiemarked
      </div>
      <h1>Fremtidens<br><em>jordleie</em><br>starter her.</h1>
      <p class="lp-hero-sub">
        Jordleie.no kobler grunneiere og bønder gjennom åpne, transparente auksjoner.
        Finn ledig jord i hele Norge – eller legg ut ditt areal i dag.
      </p>
      <div class="lp-hero-ctas">
        <a href="/logg-inn" class="btn-primary">Se auksjoner →</a>
        <a href="/lag-annonse" class="btn-outline">Legg ut din jord</a>
      </div>
    </div>

    <div class="lp-hero-img-right" aria-hidden="true">
      <img src="/images/hero-farm-illustration2.png" alt="">
    </div>

  </section>

  <!-- ===== STATS BAR ===== -->
  <div class="lp-stats">
    <div class="lp-stats-inner">
      <div class="lp-stat">
        <span class="lp-stat-value">142</span>
        <span class="lp-stat-label">Aktive auksjoner</span>
      </div>
      <div class="lp-stat">
        <span class="lp-stat-value">186</span>
        <span class="lp-stat-label">Snitt dekar per gård</span>
      </div>
      <div class="lp-stat">
        <span class="lp-stat-value">620 kr</span>
        <span class="lp-stat-label">Snitt leie per dekar</span>
      </div>
      <div class="lp-stat">
        <span class="lp-stat-value">18</span>
        <span class="lp-stat-label">Fylker representert</span>
      </div>
    </div>
  </div>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="how-section" id="slik-fungerer-det">
    <div class="how-inner">

      <h2 class="how-heading">Slik fungerer det</h2>

      <div class="how-entries">

        <!-- 01: bilde venstre | spine | tekst høyre -->
        <div class="how-entry">
          <div class="how-entry-media">
            <img class="how-img" src="/images/sfd_1.png" alt="Registrer deg">
          </div>
          <div class="how-entry-spine">
            <div class="how-marker">01</div>
          </div>
          <div class="how-entry-text">
            <h3 class="how-title">Registrer deg</h3>
            <ul class="how-list">
              <li>Opprett en gratis konto på Jordleie.no</li>
              <li>Legg inn informasjon om deg og din eiendom</li>
              <li>Vi verifiserer identitet og gårdsbruk for trygg handel</li>
            </ul>
          </div>
        </div>

        <!-- 02: tekst venstre | spine | bilde høyre (row-reverse) -->
        <div class="how-entry how-entry--flip">
          <div class="how-entry-media">
            <img class="how-img" src="/images/sfd_2.png" alt="Finn eller legg ut">
          </div>
          <div class="how-entry-spine">
            <div class="how-marker">02</div>
          </div>
          <div class="how-entry-text">
            <h3 class="how-title">Finn eller legg ut</h3>
            <ul class="how-list">
              <li>Søk etter ledige arealer i ditt fylke</li>
              <li>Eller publiser din jord med kart og auksjonsvilkår</li>
              <li>Velg startpris, varighet og leiebetingelser</li>
            </ul>
          </div>
        </div>

        <!-- 03: bilde venstre | spine | tekst høyre -->
        <div class="how-entry">
          <div class="how-entry-media">
            <img class="how-img" src="/images/sfd_3.png" alt="Bud og avtale">
          </div>
          <div class="how-entry-spine">
            <div class="how-marker">03</div>
          </div>
          <div class="how-entry-text">
            <h3 class="how-title">Bud og avtale</h3>
            <ul class="how-list">
              <li>Legg inn bud og følg auksjonen i sanntid</li>
              <li>Høyeste bud vinner når auksjonen avsluttes</li>
              <li>Inngå digital leieavtale direkte mellom partene</li>
            </ul>
          </div>
        </div>

      </div><!-- /how-entries -->

    </div><!-- /how-inner -->
  </section>

  <!-- ===== COMPARISON ===== -->
  <section class="lp-section lp-section-alt">
    <div class="lp-section-inner">
      <div class="lp-section-header">
        <span class="lp-label">Hvorfor Jordleie.no?</span>
        <h2 class="lp-section-title">Det gamle systemet er utdatert</h2>
        <p class="lp-section-desc">
          Ringerunder og usikre muntlige avtaler gagner ingen. Jordleie.no gir deg en åpen markedsplass som fungerer.
        </p>
      </div>
      <div class="lp-comparison-grid">

        <div class="lp-comparison-card old">
          <h3>Tradisjonell<br>jordleie</h3>
          <ul class="lp-comparison-list">
            <li>
              <span class="lp-check">✕</span>
              <span>Ringerunder og personlige kontakter avgjør alt</span>
            </li>
            <li>
              <span class="lp-check">✕</span>
              <span>Uklare priser – ingen vet hva markedspris er</span>
            </li>
            <li>
              <span class="lp-check">✕</span>
              <span>Muntlige eller håndskrevne avtaler</span>
            </li>
            <li>
              <span class="lp-check">✕</span>
              <span>Lite informasjon om jordkvalitet og historikk</span>
            </li>
            <li>
              <span class="lp-check">✕</span>
              <span>Vanskelig å finne ledig areal utenfor nærområdet</span>
            </li>
          </ul>
        </div>

        <div class="lp-comparison-card new">
          <h3>Jordleie.no</h3>
          <ul class="lp-comparison-list">
            <li>
              <span class="lp-check">✓</span>
              <span>Åpen markedsplass synlig for alle</span>
            </li>
            <li>
              <span class="lp-check">✓</span>
              <span>Auksjonsbasert prissetting – alltid rettferdig markedspris</span>
            </li>
            <li>
              <span class="lp-check">✓</span>
              <span>Digital leieavtale med juridisk korrekt mal</span>
            </li>
            <li>
              <span class="lp-check">✓</span>
              <span>Interaktivt kart, jordtype og full driftshistorikk</span>
            </li>
            <li>
              <span class="lp-check">✓</span>
              <span>Søk og finn ledig areal i hele Norge</span>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- ===== BENEFITS ===== -->
