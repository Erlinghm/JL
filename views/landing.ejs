  <!-- ===== KONTAKT ===== -->
  <section class="lp-section" id="kontakt">
    <div class="lp-section-inner">
      <div class="lp-kontakt-grid">
        <div class="lp-kontakt-info">
          <span class="lp-label">Kontakt</span>
          <h2 class="lp-section-title">Ta kontakt med oss</h2>
          <p class="lp-om-p">Har du spørsmål om plattformen, trenger du hjelp med en annonse, eller vil du bare si hei? Vi svarer deg gjerne.</p>
          <div class="lp-kontakt-details">
            <div class="lp-kontakt-detail">
              <span class="lp-kontakt-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </span>
              <div>
                <div class="lp-kontakt-detail-label">E-post</div>
                <div class="lp-kontakt-detail-value">hei@jordleie.no</div>
              </div>
            </div>
            <div class="lp-kontakt-detail">
              <span class="lp-kontakt-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 13 19.79 19.79 0 0 1 1.07 4.18 2 2 0 0 1 3 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <div>
                <div class="lp-kontakt-detail-label">Telefon</div>
                <div class="lp-kontakt-detail-value">+47 400 00 000</div>
              </div>
            </div>
            <div class="lp-kontakt-detail">
              <span class="lp-kontakt-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </span>
              <div>
                <div class="lp-kontakt-detail-label">Svartid</div>
                <div class="lp-kontakt-detail-value">Vi svarer innen 1–2 virkedager</div>
              </div>
            </div>
          </div>
        </div>
        <form class="lp-kontakt-form" action="/kontakt" method="POST">
          <div class="lp-form-row">
            <div class="lp-form-group">
              <label class="lp-form-label">Navn</label>
              <input class="lp-form-input" type="text" name="name" placeholder="Ditt navn" required />
            </div>
            <div class="lp-form-group">
              <label class="lp-form-label">E-post</label>
              <input class="lp-form-input" type="email" name="email" placeholder="din@epost.no" required />
            </div>
          </div>
          <div class="lp-form-group">
            <label class="lp-form-label">Emne</label>
            <input class="lp-form-input" type="text" name="subject" placeholder="Hva gjelder henvendelsen?" />
          </div>
          <div class="lp-form-group">
            <label class="lp-form-label">Melding</label>
            <textarea class="lp-form-input lp-form-textarea" name="message" placeholder="Skriv meldingen din her..." required></textarea>
          </div>
          <button type="submit" class="btn-primary" style="width:100%;justify-content:center;">Send melding →</button>
        </form>
      </div>
    </div>
  </section>

