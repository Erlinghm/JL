<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<%
  const publisherName = user.fullName || user.email || "Bruker";
  const publisherInitials = publisherName
    .split(/\s+/)
    .filter(Boolean)
    .map((part) => part[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
%>

<main class="main-content">
  <div class="listing-page">
    <section class="listing-hero">
      <div class="listing-hero-copy">
        <p class="listing-eyebrow">Ny jordleieannonse</p>
        <h1>Legg ut jord med en ryddig auksjonsprosess.</h1>
        <p>
          Beskriv arealet, tegn inn teigene og sett vilkår for budrunden. En
          tydelig annonse gjør det enklere for leietakere å vurdere arealet.
        </p>
      </div>

      <aside class="listing-publisher-card" aria-label="Publiseringsinformasjon">
        <div class="listing-publisher-profile">
          <span class="listing-publisher-avatar" aria-hidden="true"><%= publisherInitials || "BR" %></span>
          <div>
            <p>Annonsen publiseres som</p>
            <strong><%= publisherName %></strong>
            <span><%= user.email %></span>
          </div>
        </div>
        <div class="listing-publisher-note">
          <span aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </span>
          <p>Profilen din brukes som kontaktpunkt for annonsen.</p>
        </div>
      </aside>
    </section>

    <form action="/auksjoner" method="POST" class="listing-form">
      <input type="hidden" name="lat" id="lat" value="60.472">
      <input type="hidden" name="lng" id="lng" value="8.469">
      <input type="hidden" name="fieldPolygon" id="fieldPolygon" value="[]">

      <section class="listing-section" aria-labelledby="listing-basic-title">
        <div class="listing-section-heading">
          <span class="listing-section-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
          </span>
          <div>
            <p class="listing-eyebrow">Steg 1</p>
            <h2 id="listing-basic-title">Grunnleggende informasjon</h2>
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group full-width">
            <label class="form-label" for="title">Annonsetittel *</label>
            <input type="text" id="title" name="title" class="form-input" placeholder="F.eks. Flatbygd gård - Østfold korn" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="ownerName">Ditt navn *</label>
            <input type="text" id="ownerName" name="ownerName" class="form-input" value="<%= user.fullName %>" readonly required>
          </div>
          <div class="form-group">
            <label class="form-label" for="soilQuality">Jordkvalitet *</label>
            <select id="soilQuality" name="soilQuality" class="form-select">
              <option value="God">God</option>
              <option value="Middels">Middels</option>
              <option value="Varierende">Varierende</option>
            </select>
          </div>
          <div class="form-group full-width">
            <label class="form-label" for="description">Beskrivelse av arealet *</label>
            <textarea id="description" name="description" class="form-textarea" rows="4" placeholder="Beskriv arealet, jordtype, historikk og tilgjengelighet..." required></textarea>
          </div>
          <div class="form-group full-width">
            <label class="form-label" for="ownerDescription">Om deg som grunneier</label>
            <textarea id="ownerDescription" name="ownerDescription" class="form-textarea" rows="3" placeholder="Fortell kort om deg selv og hva du ser etter i en leietaker..."></textarea>
          </div>
        </div>
      </section>

      <section class="listing-section" aria-labelledby="listing-location-title">
        <div class="listing-section-heading">
          <span class="listing-section-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <div>
            <p class="listing-eyebrow">Steg 2</p>
            <h2 id="listing-location-title">Beliggenhet</h2>
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label class="form-label" for="municipality">Kommune *</label>
            <input type="text" id="municipality" name="municipality" class="form-input" placeholder="F.eks. Råde" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="fylke">Fylke *</label>
            <select id="fylke" name="fylke" class="form-select" required>
              <option value="">Velg fylke...</option>
              <option>Agder</option>
              <option>Innlandet</option>
              <option>Møre og Romsdal</option>
              <option>Nordland</option>
              <option>Oslo</option>
              <option>Rogaland</option>
              <option>Troms og Finnmark</option>
              <option>Trøndelag</option>
              <option>Vestfold og Telemark</option>
              <option>Vestland</option>
              <option>Viken</option>
              <option>Østfold</option>
            </select>
          </div>
          <div class="form-group full-width">
            <label class="form-label" for="address">Adresse / stedsbeskrivelse</label>
            <input type="text" id="address" name="address" class="form-input" placeholder="Skriv inn adressen for å sentrere kartet">
            <p class="field-help">Skriv inn adressen og trykk Tab eller Enter for å sentrere kartet.</p>
          </div>
        </div>
      </section>

      <section class="listing-section listing-map-section" aria-labelledby="listing-map-title">
        <div class="listing-section-heading">
          <span class="listing-section-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3Z"/><path d="M9 3v15"/><path d="M15 6v15"/></svg>
          </span>
          <div>
            <p class="listing-eyebrow">Steg 3</p>
            <h2 id="listing-map-title">Tegn inn teigene</h2>
          </div>
        </div>

        <div id="draw-map"></div>
        <p class="map-hint">
          Bruk polygon-verktøyet øverst til venstre på kartet. Dobbelttrykk for
          å avslutte, eller slett og tegn på nytt.
        </p>
      </section>

      <section class="listing-section" aria-labelledby="listing-details-title">
        <div class="listing-section-heading">
          <span class="listing-section-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
          </span>
          <div>
            <p class="listing-eyebrow">Steg 4</p>
            <h2 id="listing-details-title">Gårdsdetaljer</h2>
          </div>
        </div>

        <div class="form-grid-3">
          <div class="form-group">
            <label class="form-label" for="sizeDekar">Størrelse (dekar) *</label>
            <input type="number" id="sizeDekar" name="sizeDekar" class="form-input" placeholder="F.eks. 120" min="1" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="soilType">Jordtype</label>
            <select id="soilType" name="soilType" class="form-select">
              <option value="Leirjord">Leirjord</option>
              <option value="Sandjord">Sandjord</option>
              <option value="Mellomleirjord">Mellomleirjord</option>
              <option value="Siltig lettleire">Siltig lettleire</option>
              <option value="Humusrik jord">Humusrik jord</option>
              <option value="Myrjord">Myrjord</option>
              <option value="Annet">Annet</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="rentalPeriodYears">Leieperiode (år) *</label>
            <select id="rentalPeriodYears" name="rentalPeriodYears" class="form-select">
              <option value="1">1 år</option>
              <option value="3">3 år</option>
              <option value="4">4 år</option>
              <option value="5" selected>5 år</option>
              <option value="6">6 år</option>
              <option value="7">7 år</option>
              <option value="10">10 år</option>
            </select>
          </div>
        </div>

        <div class="form-group crop-fieldset">
          <label class="form-label">Egnet for</label>
          <div class="checkbox-group">
            <% ["korn", "hvete", "bygg", "havre", "raps", "potet", "grønnsaker", "bær", "frukt", "gras", "beite"].forEach(crop => { %>
              <label class="checkbox-label">
                <input type="checkbox" name="cropTypes" value="<%= crop %>">
                <%= crop %>
              </label>
            <% }) %>
          </div>
        </div>
      </section>

      <section class="listing-section" aria-labelledby="listing-auction-title">
        <div class="listing-section-heading">
          <span class="listing-section-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L2 12V2h10l8.6 8.6a2 2 0 0 1 0 2.8Z"/><path d="M7 7h.01"/></svg>
          </span>
          <div>
            <p class="listing-eyebrow">Steg 5</p>
            <h2 id="listing-auction-title">Auksjonsinformasjon</h2>
          </div>
        </div>

        <div class="form-grid-3">
          <div class="form-group">
            <label class="form-label" for="startingBid">Startbud (kr/daa/år) *</label>
            <input type="number" id="startingBid" name="startingBid" class="form-input" placeholder="F.eks. 500" min="0" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="auctionStart">Auksjon starter *</label>
            <input type="date" id="auctionStart" name="auctionStart" class="form-input" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="auctionEnd">Auksjon slutter *</label>
            <input type="date" id="auctionEnd" name="auctionEnd" class="form-input" required>
          </div>
        </div>

        <div class="listing-estimate" aria-live="polite">
          <div>
            <span>Estimert leieinntekt ved startbud</span>
            <strong id="estimate">-</strong>
          </div>
          <p>Per år basert på startbud ganger areal.</p>
        </div>
      </section>

      <div class="listing-actions">
        <a href="/auksjoner" class="btn btn-outline">Avbryt</a>
        <button type="submit" class="btn btn-primary btn-lg">Publiser annonse</button>
      </div>
    </form>
  </div>

  <%- include('partials/footer') %>
</main>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sizeInput = document.getElementById("sizeDekar");
    const bidInput  = document.getElementById("startingBid");
    const estimate  = document.getElementById("estimate");

    function updateEstimate() {
      const size = parseFloat(sizeInput.value) || 0;
      const bid  = parseFloat(bidInput.value)  || 0;
      if (size > 0 && bid > 0) {
        estimate.textContent = (size * bid).toLocaleString("no-NO") + " kr/år";
      } else {
        estimate.textContent = "-";
      }
    }

    sizeInput.addEventListener("input", updateEstimate);
    bidInput.addEventListener("input", updateEstimate);

    const today = new Date();
    const end = new Date(today);
    end.setDate(end.getDate() + 21);
    document.getElementById("auctionStart").value = today.toISOString().slice(0, 10);
    document.getElementById("auctionEnd").value = end.toISOString().slice(0, 10);
  });
</script>
